# Clave de la API de Groq (gratuita): se consigue en https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: qué modelo usar. Por defecto, openai/gpt-oss-120b. En
# https://console.groq.com/docs/models, usa solo los que tengan precio en dólares y
# límites en la columna "RATE LIMITS (DEVELOPER PLAN)": los marcados "Enterprise" /
# "ContactSales" no funcionan con una clave normal.
GROQ_MODEL=
