# Clave de la API de Groq (gratuita): se consigue en https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: qué modelo usar (ver los disponibles en https://console.groq.com/docs/models).
# Por defecto, llama-3.1-8b-instant. Groq retira modelos del catálogo gratuito con
# cierta frecuencia; si el que hay por defecto deja de existir, pon aquí otro.
GROQ_MODEL=
